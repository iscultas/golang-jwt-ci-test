      "source": {
        "rfc": "RFC7797",
        "section": "5.2",
        "section_title": "Unencoded JWS Compact Serialization Payload",
        "anchor": "section-5.2",
        "line_start": 412,
        "line_end": 425,
        "block_kind": "prose",
        "text": "When using the JWS Compact Serialization, unencoded non-detached payloads using period ('.') characters would cause parsing errors; such payloads MUST NOT be used with the JWS Compact Serialization.",
        "text_sha256_12": "89d8878ef47a"
      },
