        "rfc": "RFC9864",
        "section": "3",
        "section_title": "Fully-Specified Encryption",
        "anchor": "fully-specified-enc",
        "line_start": 0,
        "line_end": 0,
        "block_kind": "prose",
        "text": "To perform fully-specified encryption in JOSE, the \"alg\" value MUST specify all parameters for key establishment or derive some of them from the accompanying \"enc\" value, and the \"enc\" value MUST specify all parameters for symmetric encryption.",
        "text_sha256_12": "62fe3cdee341"
      },
